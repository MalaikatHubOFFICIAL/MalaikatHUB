-- ─── CACHING SYSTEM ───────────────────────────────────────────────────────

local cachedBatteries = {}



local function processInstance(obj)

    if not obj or not obj.Parent then return end

    if obj:IsA("TouchTransmitter") or obj:IsA("TouchInterest") then

        local part = obj.Parent

        if not part or not part:IsA("BasePart") then return end

        local model = part.Parent

        local partName = string.lower(part.Name)

        local modelName = model and string.lower(model.Name) or ""



        if (string.find(modelName, "lock") or string.find(partName, "lock") or partName == "hit") and not string.find(modelName, "free") then

            part.CanTouch = false

            pcall(function() obj:Destroy() end)

            return

        end



        if string.find(modelName, "battery") or string.find(partName, "battery") or string.find(modelName, "cell") or string.find(modelName, "reactor") then

            if not table.find(cachedBatteries, part) then table.insert(cachedBatteries, part) end

        end

    end

end



for _, obj in ipairs(game:GetDescendants()) do processInstance(obj) end

table.insert(Connections, Workspace.DescendantAdded:Connect(processInstance))



