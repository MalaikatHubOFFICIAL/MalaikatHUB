    tabBtn.BorderSizePixel = 0

    tabBtn.Parent = Sidebar

    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 4)



    local activeBar = Instance.new("Frame", tabBtn)

    activeBar.Size = UDim2.new(0, 3, 0.6, 0)

    activeBar.Position = UDim2.new(0, 3, 0.2, 0)

    activeBar.BorderSizePixel = 0

    Instance.new("UICorner", activeBar).CornerRadius = UDim.new(1, 0)



    local function updateTabColors()

        if page.Visible then

            TweenService:Create(tabBtn, TweenInfo.new(0.2), {BackgroundColor3 = CurrentTheme.CardBg, TextColor3 = CurrentTheme.Text}):Play()

            TweenService:Create(activeBar, TweenInfo.new(0.2), {BackgroundTransparency = 0, BackgroundColor3 = CurrentTheme.Accent}):Play()

        else

            TweenService:Create(tabBtn, TweenInfo.new(0.2), {BackgroundColor3 = CurrentTheme.SidebarBg, TextColor3 = CurrentTheme.SubText}):Play()

            TweenService:Create(activeBar, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()

        end

    end



    RegisterTheme(function(t) 

        page.ScrollBarImageColor3 = t.SubText

        updateTabColors() 

    end)



    tabBtn.MouseButton1Click:Connect(function()

        for _, p in pairs(Pages) do p.Visible = false end

        page.Visible = true

        for _, b in pairs(TabButtons) do b.Update() end

    end)



    Pages[name] = page

    TabButtons[name] = { Button = tabBtn, Update = updateTabColors }

    return page

end



