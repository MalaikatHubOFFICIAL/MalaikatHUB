function StealHighestBattery()

    local char = LocalPlayer.Character

    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end

    local hrp = char.HumanoidRootPart



    local myPlot = GetMyPlot()

    local detectedTargets = {}



    for _, prompt in ipairs(Workspace:GetDescendants()) do

        if prompt:IsA("ProximityPrompt") and prompt.Enabled then

            local parentObj = prompt.Parent

            if parentObj then

                local fullPath = string.lower(parentObj:GetFullName())

                local actText   = string.lower(prompt.ActionText or "")

                local objText   = string.lower(prompt.ObjectText or "")



                local isBlacklisted = string.find(fullPath, "news") 

                    or string.find(fullPath, "board") 

                    or string.find(fullPath, "shop") 

                    or string.find(actText, "join") 

                    or string.find(actText, "buy")



                local isMyPlot = false

                if myPlot and (parentObj == myPlot or parentObj:IsDescendantOf(myPlot)) then

                    isMyPlot = true

                end



                if not isBlacklisted and not isMyPlot then

                    local searchText = fullPath .. " " .. actText .. " " .. objText

                    local bestScore = 0

                    local matchedName = parentObj.Name



                    for key, score in pairs(ITEM_TIER_PRIORITY) do

                        if string.find(searchText, key) then

                            if score > bestScore then

                                bestScore = score

                                matchedName = key

                            end

                        end

                    end



                    if bestScore == 0 and (string.find(actText, "steal") or string.find(actText, "take") or string.find(objText, "battery") or string.find(fullPath, "battery")) then

                        bestScore = 10

                    end



                    if bestScore > 0 then

                        local targetCFrame = nil

                        if parentObj:IsA("BasePart") then

                            targetCFrame = parentObj.CFrame

                        elseif parentObj:IsA("Model") then

                            targetCFrame = parentObj:GetPivot()

                        end



                        if targetCFrame then

                            table.insert(detectedTargets, {

                                Prompt = prompt,

                                TargetCFrame = targetCFrame,

                                Name = matchedName,

                                Score = bestScore

                            })

                        end

                    end

                end

            end

        end

    end



    if #detectedTargets > 0 then

        table.sort(detectedTargets, function(a, b) return a.Score > b.Score end)

        local best = detectedTargets[1]



        Notify({ Title = "Stealing Target", Content = "Stealing: " .. string.upper(best.Name) .. " (Score: " .. best.Score .. ")", Duration = 2 })



        hrp.CFrame = best.TargetCFrame * CFrame.new(0, 0, -1.2)

        task.wait(0.15)



        best.Prompt.RequiresLineOfSight = false

        best.Prompt.MaxActivationDistance = 100

        if getgenv().InstantInteractToggle then best.Prompt.HoldDuration = 0 end



        pcall(function()

            if fireproximityprompt then

                fireproximityprompt(best.Prompt)

            end

            best.Prompt:InputHoldBegin()

            task.wait(0.08)

            best.Prompt:InputHoldEnd()

        end)



        task.wait(0.25)

        TeleportHome()

        return true

    else

        Notify({ Title = "Steal Fail", Content = "No enemy battery found in server!", Duration = 2 })

    end

    return false

end



