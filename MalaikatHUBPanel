            BackgroundColor3 = state and CurrentTheme.MainBg or CurrentTheme.SubText

        }):Play()

        callback(state)

    end



    btn.MouseButton1Click:Connect(function() updateToggle(not state) end)

    return { Set = updateToggle }

end



