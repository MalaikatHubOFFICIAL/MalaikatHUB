local function GetMyPlot()

    local myName = string.lower(LocalPlayer.Name)

    local myDisplayName = string.lower(LocalPlayer.DisplayName)

    

    local plotsFolder = Workspace:FindFirstChild("Plots") 

        or Workspace:FindFirstChild("Bases") 

        or Workspace:FindFirstChild("Tycoons") 

        or Workspace:FindFirstChild("Islands")

        or Workspace



    for _, plot in ipairs(plotsFolder:GetChildren()) do

        if plot == LocalPlayer.Character then continue end



        local ownerVal = plot:FindFirstChild("Owner") or plot:FindFirstChild("Player") or plot:FindFirstChild("Leader")

        if ownerVal then

            if ownerVal:IsA("StringValue") and (string.find(string.lower(ownerVal.Value), myName) or string.find(string.lower(ownerVal.Value), myDisplayName)) then

                return plot

            elseif ownerVal:IsA("ObjectValue") and ownerVal.Value == LocalPlayer then

                return plot

            end

        end



        local attrOwner = plot:GetAttribute("Owner") or plot:GetAttribute("Player")

        if attrOwner and (string.find(string.lower(tostring(attrOwner)), myName) or string.find(string.lower(tostring(attrOwner)), myDisplayName)) then

            return plot

        end



        for _, gui in ipairs(plot:GetDescendants()) do

            if (gui:IsA("TextLabel") or gui:IsA("TextButton")) and gui.Text ~= "" then

                local txt = string.lower(gui.Text)

                if string.find(txt, myName) or string.find(txt, myDisplayName) then

                    return plot

                end

            end

        end

    end



    return nil

end



