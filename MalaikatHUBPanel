-- ─── LOGIKA DETEKSI TIMER LOCK KETAT (PERBAIKAN FALSE POSITIVE) ──────────────

local function GetLockTimerFromText(plotObj)

    if not plotObj then return nil end

    

    for _, desc in ipairs(plotObj:GetDescendants()) do

        if desc:IsA("TextLabel") and desc.Text ~= "" then

            local txt = string.lower(desc.Text)

            local path = string.lower(desc:GetFullName())



            -- Pastikan teks berasal dari elemen terkait Lock/Shield

            local isLockContext = string.find(txt, "lock") or string.find(path, "lock")

                or string.find(txt, "shield") or string.find(path, "shield")

                or string.find(txt, "door") or string.find(path, "door")

                or string.find(txt, "gate") or string.find(path, "gate")

                or string.find(txt, "time") or string.find(txt, "close")



            -- Abaikan teks Robux, Uang ($), dan Skor

            local isIgnored = string.find(txt, "24h") or string.find(txt, "robux") or string.find(txt, "%$") or string.find(txt, "cash") or string.find(txt, "money")



            if isLockContext and not isIgnored then

                local detectedSec = string.match(txt, "(%d+)s") or string.match(txt, "(%d+) s") or string.match(txt, "(%d+)sec")

                if detectedSec then

                    return tonumber(detectedSec)

                end

            end

        end

    end

    return nil

end



